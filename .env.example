# Database Configuration (Appliku provides DATABASE_URL automatically)
# For local development with MySQL:
# DATABASE_URL=mysql://root:your-password@localhost:3306/inventory
# For local development with SQLite:
# DATABASE_URL=sqlite:///db.sqlite3

